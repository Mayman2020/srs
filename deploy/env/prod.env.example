HTTP_PORT=80
POSTGRES_USER=ac_prod
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
POSTGRES_DB=postgres

SPRING_PROFILES_ACTIVE=prod

# ── JWT ──────────────────────────────────────────────────────────────────────
# HS256 — minimum 32 UTF-8 bytes. Generate: openssl rand -base64 48
AC_JWT_SECRET=REPLACE_MIN_32_BYTES_FROM_VAULT_ROTATE_QUARTERLY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact production origin (no wildcards in prod).
AC_CORS_ALLOWED_ORIGIN_PATTERNS=https://ac.example.gov

# ── Camunda ──────────────────────────────────────────────────────────────────
CAMUNDA_BPM_ADMIN_USER=REPLACE_NON_DEFAULT_USER
CAMUNDA_BPM_ADMIN_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587

# ── TLS / HSTS ───────────────────────────────────────────────────────────────
# Behind TLS-terminating proxy; Spring Boot HSTS disabled (enforce at edge).
AC_SECURITY_HSTS_ENABLED=false

# ── Attachment encryption (AES-256-GCM) ─────────────────────────────────────
# MANDATORY in production. Generate: openssl rand -hex 32
# 64 hex chars = 32-byte AES-256 KEK. Rotate by issuing a new ref + KEK.
AC_ATTACHMENT_ENCRYPTION_ENABLED=true
AC_ATTACHMENT_KEK_REF=KEK_V1
AC_ATTACHMENT_KEK_HEX=REPLACE_64_HEX_CHARS_FROM_VAULT

# ── Digital signatures (ED25519) ─────────────────────────────────────────────
# Generate keypair:
#   openssl genpkey -algorithm ed25519 -out sign_private.pem
#   openssl pkey -in sign_private.pem -pubout -out sign_public.pem
# Then set the PEM content (newlines as \n) or use a secret manager reference.
AC_SIGN_KEY_REF=SIGN_V1
AC_SIGN_PRIVATE_KEY_PEM=REPLACE_WITH_ED25519_PRIVATE_KEY_PEM
AC_SIGN_PUBLIC_KEY_PEM=REPLACE_WITH_ED25519_PUBLIC_KEY_PEM

# ── Retention lifecycle ───────────────────────────────────────────────────────
# Set to false when retention is intended to run in production.
# Default is true (dry-run) — no actual archival/deletion until explicitly enabled.
AC_RETENTION_DRY_RUN=false

# ── Notification webhook signing ─────────────────────────────────────────────
# Optional: shared HMAC secret for outbound webhook/Teams POST signing.
# AC_NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE

# ── Storage ──────────────────────────────────────────────────────────────────
# Absolute path inside the container (mapped to a persistent volume).
AC_STORAGE_ROOT=/data/attachments
