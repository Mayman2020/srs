# Copy to .env next to this file (or pass --env-file) before `docker compose up`.
# Values below are safe for local Docker Desktop validation only — replace for real staging/prod.

HTTP_PORT=8080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password-16chars
POSTGRES_DB=ac_communications

SPRING_PROFILES_ACTIVE=staging

# HS256 — minimum 32 UTF-8 bytes (generate: openssl rand -base64 48)
AC_JWT_SECRET=change-me-jwt-secret-minimum-32-characters-long!!

# Comma-separated CORS patterns. Local gateway: browser Origin is http://127.0.0.1:8080 or http://localhost:8080
AC_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

CAMUNDA_BPM_ADMIN_USER=admin
CAMUNDA_BPM_ADMIN_PASSWORD=change-me-camunda-admin

SMTP_HOST=localhost
SMTP_PORT=1025
