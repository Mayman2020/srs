<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Inbound"
                  targetNamespace="http://ac.gov/bpmn"
                  exporter="SRS"
                  exporterVersion="2.0">
  <bpmn:process id="inbound-correspondence"
                name="Inbound Correspondence (Q/L/K/S routed)"
                isExecutable="true"
                camunda:historyTimeToLive="180">

    <!-- ============================= Start ============================= -->
    <bpmn:startEvent id="StartEvent_Inbound" name="Inbound received">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${routingChainDelegate}" event="start"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>

    <!-- ============================= Register ============================ -->
    <bpmn:userTask id="Task_Register"
                   name="Register inbound correspondence"
                   camunda:assignee="${initiator}">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${correspondenceTaskAssignmentListener}" event="create"/>
        <camunda:taskListener delegateExpression="${correspondenceWorkflowPersistenceTaskListener}" event="complete"/>
        <camunda:taskListener delegateExpression="${correspondenceWorkflowNotificationTaskListener}" event="complete"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- ===================== Multi-instance routing chain ===================== -->
    <!-- One user task per routing stop produced by routingChainDelegate. -->
    <bpmn:subProcess id="Sub_RoutingChain" name="Routing chain">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"
                                             camunda:collection="${routingStops}"
                                             camunda:elementVariable="routingStop">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${wfDecision == 'REJECT'}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="Start_Stop"/>

      <bpmn:userTask id="Task_Stop_Action"
                     name="Act on correspondence (${routingStop.levelCode})">
        <bpmn:extensionElements>
          <camunda:taskListener delegateExpression="${routingStopAssignmentListener}" event="create"/>
          <camunda:taskListener delegateExpression="${correspondenceWorkflowPersistenceTaskListener}" event="complete"/>
          <camunda:taskListener delegateExpression="${correspondenceWorkflowNotificationTaskListener}" event="complete"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <!-- Boundary timer: SLA escalation after configurable timeout (PT2H by default). -->
      <bpmn:boundaryEvent id="Timer_Escalate" attachedToRef="Task_Stop_Action" cancelActivity="false">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <bpmn:endEvent id="End_Stop"/>

      <bpmn:sequenceFlow id="Flow_Stop_1" sourceRef="Start_Stop" targetRef="Task_Stop_Action"/>
      <bpmn:sequenceFlow id="Flow_Stop_2" sourceRef="Task_Stop_Action" targetRef="End_Stop"/>
      <bpmn:sequenceFlow id="Flow_Stop_Escalate" sourceRef="Timer_Escalate" targetRef="End_Stop"/>
    </bpmn:subProcess>

    <!-- ============================ Outcome gateway ============================ -->
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Outcome" default="Flow_Complete"/>

    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Returned" name="Returned">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Completed">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <!-- ============================ Sequence flows ============================ -->
    <bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="StartEvent_Inbound" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_Register_Chain" sourceRef="Task_Register" targetRef="Sub_RoutingChain"/>
    <bpmn:sequenceFlow id="Flow_Chain_Gateway" sourceRef="Sub_RoutingChain" targetRef="Gateway_Outcome"/>

    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gateway_Outcome" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wfDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Return" sourceRef="Gateway_Outcome" targetRef="EndEvent_Returned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wfDecision == 'RETURN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Complete" sourceRef="Gateway_Outcome" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>
