<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Internal"
                  targetNamespace="http://ac.gov/bpmn"
                  exporter="SRS"
                  exporterVersion="2.0">
  <bpmn:process id="internal-correspondence"
                name="Internal Correspondence (Q/L/K/S routed)"
                isExecutable="true"
                camunda:historyTimeToLive="180">

    <bpmn:startEvent id="StartEvent_Internal" name="Internal originated">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${routingChainDelegate}" event="start"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Compose"
                   name="Compose internal correspondence"
                   camunda:assignee="${initiator}">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${correspondenceTaskAssignmentListener}" event="create"/>
        <camunda:taskListener delegateExpression="${correspondenceWorkflowPersistenceTaskListener}" event="complete"/>
        <camunda:taskListener delegateExpression="${correspondenceWorkflowNotificationTaskListener}" event="complete"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:subProcess id="Sub_InternalChain" name="Routing chain (Q/L/K/S)">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"
                                             camunda:collection="${routingStops}"
                                             camunda:elementVariable="routingStop">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${wfDecision == 'REJECT'}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="Start_Internal_Stop"/>

      <bpmn:userTask id="Task_Internal_Stop"
                     name="Process at ${routingStop.levelCode}">
        <bpmn:extensionElements>
          <camunda:taskListener delegateExpression="${routingStopAssignmentListener}" event="create"/>
          <camunda:taskListener delegateExpression="${correspondenceWorkflowPersistenceTaskListener}" event="complete"/>
          <camunda:taskListener delegateExpression="${correspondenceWorkflowNotificationTaskListener}" event="complete"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:boundaryEvent id="Timer_Escalate_Internal" attachedToRef="Task_Internal_Stop" cancelActivity="false">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <bpmn:endEvent id="End_Internal_Stop"/>

      <bpmn:sequenceFlow id="Flow_Int_Stop_1" sourceRef="Start_Internal_Stop" targetRef="Task_Internal_Stop"/>
      <bpmn:sequenceFlow id="Flow_Int_Stop_2" sourceRef="Task_Internal_Stop" targetRef="End_Internal_Stop"/>
      <bpmn:sequenceFlow id="Flow_Int_Stop_Escalate" sourceRef="Timer_Escalate_Internal" targetRef="End_Internal_Stop"/>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_InternalOutcome" name="Outcome" default="Flow_Internal_Complete"/>

    <bpmn:endEvent id="EndEvent_Internal_Rejected" name="Rejected">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Internal_Returned" name="Returned">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Internal_Completed" name="Completed">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${finalStatusExecutionListener}" event="end"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Compose" sourceRef="StartEvent_Internal" targetRef="Task_Compose"/>
    <bpmn:sequenceFlow id="Flow_Compose_Chain" sourceRef="Task_Compose" targetRef="Sub_InternalChain"/>
    <bpmn:sequenceFlow id="Flow_Chain_Gateway_Int" sourceRef="Sub_InternalChain" targetRef="Gateway_InternalOutcome"/>

    <bpmn:sequenceFlow id="Flow_Internal_Reject" sourceRef="Gateway_InternalOutcome" targetRef="EndEvent_Internal_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wfDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Internal_Return" sourceRef="Gateway_InternalOutcome" targetRef="EndEvent_Internal_Returned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wfDecision == 'RETURN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Internal_Complete" sourceRef="Gateway_InternalOutcome" targetRef="EndEvent_Internal_Completed"/>

  </bpmn:process>
</bpmn:definitions>
